<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <!-- Aplicación de consola .NET 8 -->
    <OutputType>Exe</OutputType>
    <TargetFramework>net8.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <RootNamespace>OccScraper</RootNamespace>
    <AssemblyName>OccScraper</AssemblyName>
    <!-- Permite ejecutar este build de net8.0 sobre un runtime mayor (ej. 10.0)
         cuando el runtime 8.0 exacto no está instalado. -->
    <RollForward>LatestMajor</RollForward>
    <!-- Cultura invariante para evitar sorpresas con acentos/formatos -->
    <InvariantGlobalization>false</InvariantGlobalization>
  </PropertyGroup>

  <ItemGroup>
    <!-- Binding oficial de Playwright para .NET (controla Chromium headless) -->
    <PackageReference Include="Microsoft.Playwright" Version="1.49.0" />
    <!-- Lectura de appsettings.json -->
    <PackageReference Include="Microsoft.Extensions.Configuration" Version="8.0.0" />
    <PackageReference Include="Microsoft.Extensions.Configuration.Binder" Version="8.0.0" />
    <PackageReference Include="Microsoft.Extensions.Configuration.Json" Version="8.0.0" />
    <PackageReference Include="Microsoft.Extensions.Configuration.CommandLine" Version="8.0.0" />
  </ItemGroup>

  <ItemGroup>
    <!-- Copiar appsettings.json al directorio de salida en cada build -->
    <None Update="appsettings.json">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </None>
  </ItemGroup>

</Project>
